{
  "manifest_version": 3,
  "name": "Ruijie Cloud Project Export",
  "version": "0.2.1",
  "description": "Export the current Ruijie Cloud project as a read-only JSON snapshot.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://cloud-as.ruijienetworks.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://cloud-as.ruijienetworks.com/macc5/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_title": "Export Ruijie project",
    "default_popup": "popup.html"
  }
}
